{
  "schema_version": 1,
  "repository": {
    "id": "qb2tr-repo",
    "name": "QB2TR自动转移做种仓库",
    "homepage": "https://github.com/15373426383s-wq/dian115-qb2tr-plugin"
  },
  "plugins": [
    {
      "id": "com.15373426383s-wq.qb2tr-transfer",
      "name": "QB→TR自动转移做种",
      "description": "自动将 qBittorrent 中已完成的任务转移到 Transmission 继续做种",
      "version": "1.0.0",
      "author": "15373426383s-wq",
      "homepage": "https://github.com/15373426383s-wq/dian115-qb2tr-plugin",
      "package_url": "https://github.com/15373426383s-wq/dian115-qb2tr-plugin/releases/download/v1.0.0/qb2tr-transfer.d115p",
      "sha256": "0d898c8eab6201eb5a1c023f817a16037bd67ae6853424619c40e6d31acd92d3",
      "runtime": {
        "kind": "wasm",
        "protocol": "dian115:wasm@1",
        "autostart": true,
        "trust_level": "wasm-sandbox"
      },
      "permissions": {
        "apis": [],
        "network": [
          {
            "origin": "http://qb:8080",
            "methods": ["GET", "POST"],
            "proxy_mode": "direct",
            "reason": "访问 qBittorrent Web API"
          },
          {
            "origin": "http://tr:9091",
            "methods": ["GET", "POST"],
            "proxy_mode": "direct",
            "reason": "访问 Transmission RPC"
          }
        ]
      },
      "tags": ["qBittorrent", "Transmission", "做种"]
    }
  ]
}
